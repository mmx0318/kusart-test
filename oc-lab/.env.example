# Copy to oc-lab/.env. Do not commit .env. Real environment variables win over this file.

# Local preview: open the UI without the shared-password login.
OC_LAB_DEV_BYPASS_AUTH=1

# `python app.py` already serves at /. Set this only if a reverse proxy mounts the app elsewhere.
# Production WSGI import (gunicorn app:app) still defaults to /oc-lab/ when this is unset.
# OC_LAB_BASE=/

# OC_LAB_HOST=127.0.0.1
# OC_LAB_PORT=8791
# Cookie Secure flag. Unset: on for WSGI import, off for `python app.py` over plain HTTP.
# OC_LAB_COOKIE_SECURE=0

# Shared-password login when the bypass is off. Code default is kusart.
# TEAM_ANSWER=

# Ask Agent. If ASK_AGENT_URL is set, POST /api/ask-agent forwards the scene JSON there.
# ASK_AGENT_URL=https://example.com/hooks/ask
# ASK_AGENT_BEARER=

# Otherwise the endpoint uses OpenRouter through the existing llm() helper.
# OPENROUTER_API_KEY=

# Image / video generation. The preview UI loads without these; gen calls fail until one is set.
# KUSA_B2B_KEY=
# OC_LAB_MMX_TOKEN=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=

# Optional on-disk data. Unset: use /home/admin/... when that directory exists, else oc-lab/data/...
# OC_LAB_STYLE_DEMO=
# OC_LAB_TMP=
# OC_LAB_STYLE_UNI=
# OC_LAB_MMX_TOKEN_FILE=
# KUSA_B2B_KEY_FILE=
# OC_LAB_MINT_TOKEN=
